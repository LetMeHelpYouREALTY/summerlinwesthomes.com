# Public Images hash is also the default in lib/images.ts.
NEXT_PUBLIC_CLOUDFLARE_IMAGES_HASH=byE6BTe9lNqo21V57n4aPQ

# Used only by `npm run images:upload-cf`. Do not commit the token.
CLOUDFLARE_ACCOUNT_ID=2cc579c1ec9e426ed585e933ebf4753b
CLOUDFLARE_API_TOKEN=

# Cloudflare Web Analytics beacon token (public). Default is in app/layout.tsx.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=b0f528382e16497dbb2b6e14511e010d

# Cloudflare Turnstile ("Hub lead forms" widget). Site key is public; default in lib/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFq-f9ovQY6gkr2T
# Secret: set in Vercel only. While unset, /api/contact skips the Turnstile check.
TURNSTILE_SECRET_KEY=
