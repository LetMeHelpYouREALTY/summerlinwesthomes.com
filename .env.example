# Canonical site origin for metadata, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://summerlinwesthomes.com

# Cloudflare R2 public origin for photographs. Leave empty to serve git
# copies from /images on the Next.js host (local/dev fallback).
# Example: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Production: https://media.summerlinwesthomes.com
NEXT_PUBLIC_CLOUDFLARE_R2_URL=

# Bucket name used by `npm run sync:images`
CLOUDFLARE_R2_BUCKET=summerlinwest-homes-media

# Wrangler / R2 upload credentials (never commit real values).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
